# Compose profiles to start by default (so plain `docker compose up -d` runs everything).
COMPOSE_PROFILES=airflow,observability

# Copy to infra/.env and adjust. infra/.env is gitignored.
# Compose reads .env from the directory of the main compose file (infra/).

# --- Postgres (Airflow metadata DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow
# Host-side port. 5433 avoids clashing with a Postgres installed on the host.
POSTGRES_PORT=5433

# --- Airflow ---
# Generate with scripts/bootstrap (or: openssl rand -base64 32 | tr '+/' '-_' for the Fernet key,
# openssl rand -hex 32 for the others). All Airflow components must share the same values.
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
# Host-side port; 8081 avoids clashing with another Airflow already on 8080.
AIRFLOW_PORT=8081

# --- SEC ingestion ---
# Required by SEC fair-access rules: a descriptive name and contact email, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=
# Path inside the Airflow containers where Bronze data lands (mounted from ./data).
BRONZE_ROOT=/opt/airflow/data

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
LOKI_PORT=3100
